{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/voice.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/voice",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
