# Vercel Environment Variables (Project Settings → Environment Variables)
# Paste these values into Vercel. Never commit real keys.

# Required — comma-separated lists
GROQ_API_KEYS=gsk_first,gsk_second
GEMINI_API_KEYS=AQ_first,AQ_second
ELEVENLABS_API_KEYS=sk_first,sk_second

# Optional — mascot voice. Defaults to Laura, the brightest pre-made voice.
# (ELEVENLABS_VOICE_ID is retired; it is only used as a last-resort fallback.)
ELEVENLABS_MASCOT_VOICE_ID=FGY2WhTYpPnrIDTdsKH5

# Optional — per-account clone IDs, tried only if the mascot voice fails
ELEVENLABS_VOICE_IDS={"sk_first":"voice_id_for_first","sk_second":"voice_id_for_second"}

# Optional model overrides
ELEVENLABS_MODEL=eleven_v3
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Optional — mascot voice. Defaults to Leda, the highest prebuilt voice.
GEMINI_MASCOT_VOICE=Leda

# Local development only: keep the same values in api.local.json (gitignored).
